{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Http",
        "Args": {
          "requestUri": "http://victorialogs:9428/insert/jsonline?_stream_fields=service,environment&_msg_field=@m&_time_field=@t",
          "batchFormatter": "Serilog.Sinks.Http.BatchFormatters.LinesBatchFormatter, Serilog.Sinks.Http",
          "textFormatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "service": "api-gateway",
      "environment": "Development"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "basket-route-post": {
        "ClusterId": "basket-cluster",
        "Order": 1,
        "Match": {
          "Path": "/basket-api/{**catch-all}",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "create-basket-policy",
        "Transforms": [
          {
            "PathRemovePrefix": "/basket-api"
          }
        ]
      },
      "basket-route-get": {
        "ClusterId": "basket-cluster",
        "Order": 2,
        "Match": {
          "Path": "/basket-api/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "get-basket-policy",
        "Transforms": [
          {
            "PathRemovePrefix": "/basket-api"
          }
        ]
      },
      "product-route-search": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/gateway/products/search",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "search-product-policy",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/gateway/products"
          },
          {
            "PathPrefix": "/api/products"
          }
        ]
      },
      "product-route-post": {
        "ClusterId": "product-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/gateway/products/bulk-merge",
          "Methods": [ "POST" ]
        },
        "RateLimiterPolicy": "get-product-policy",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/gateway/products"
          },
          {
            "PathPrefix": "/api/products"
          }
        ]
      },
      "product-route-get": {
        "ClusterId": "product-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/gateway/products/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "get-product-policy",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/gateway/products"
          },
          {
            "PathPrefix": "/api/products"
          }
        ]
      },
      "product-route-get-all": {
        "ClusterId": "product-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/gateway/products",
          "Methods": [ "GET" ]
        },
        "RateLimiterPolicy": "get-product-policy",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/gateway/products"
          },
          {
            "PathPrefix": "/api/products"
          }
        ]
      },
      "product-route-delete": {
        "ClusterId": "product-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/gateway/products/{barcode}",
          "Methods": [ "DELETE" ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/gateway/products"
          },
          {
            "PathPrefix": "/api/products"
          }
        ]
      },
      "stock-route": {
        "ClusterId": "stock-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/stocks/{**catch-all}"
        },
        "Transforms": []
      }
    },
    "Clusters": {
      "basket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://basket-api:8080"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://product-api:8080"
          }
        }
      },
      "stock-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://stock-api:8080"
          }
        }
      }
    }
  }
}
